{% comment %}
  Anywear – Our Story (Aurora). Section: Story: reviews
{% endcomment %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">
<style>
  .aw-s-reviews{--bg:#FBFAFD;--soft:#F1EEF7;--ink:#17142A;--body:#5E5A72;--mute:#9E99B2;--line:#E7E3F0;--accent:#6D4BD8;--r:26px;position:relative;font-family:'Poppins',system-ui,-apple-system,sans-serif;font-weight:300;font-size:15px;line-height:1.8;color:var(--ink);-webkit-font-smoothing:antialiased;padding:calc(var(--pt) * .6) 0 calc(var(--pb) * .6)}
  @media (min-width:750px){.aw-s-reviews{padding:var(--pt) 0 var(--pb)}}
  .aw-s-reviews *,.aw-s-reviews *::before,.aw-s-reviews *::after{box-sizing:border-box}
  .aw-s-reviews :is(h1,h2,h3,p,blockquote,figure){margin:0;font-family:inherit;color:inherit;font-weight:400;letter-spacing:-.025em;line-height:1.18}
  .aw-s-reviews p{line-height:1.8;letter-spacing:0;font-weight:300}
  .aw-s-reviews img{display:block;max-width:100%}
  .aw-s-reviews button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0;letter-spacing:inherit}
  .aw-s-reviews .aw-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,40px)}
  .aw-s-reviews .aw-label{display:block;font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;line-height:1.5}
  .aw-s-reviews .aw-ph{background:var(--soft);overflow:hidden;border-radius:var(--r)}
  .aw-s-reviews .aw-ph img{width:100%;height:100%;object-fit:cover}
  .aw-s-reviews .aw-muted{color:var(--body)}
  .aw-s-reviews .aw-glass{background:rgba(255,255,255,.55);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);border:1px solid rgba(255,255,255,.85);box-shadow:0 20px 50px rgba(40,20,90,.08)}
  .aw-s-reviews .aw-grad{background:linear-gradient(90deg,#6D4BD8,#D9546D 55%,#E8914A);-webkit-background-clip:text;background-clip:text;color:transparent}
  .aw-s-reviews .aw-center{text-align:center;max-width:720px;margin:0 auto}
  .aw-s-reviews .aw-center h2{font-size:clamp(28px,3.6vw,50px);font-weight:500;letter-spacing:-.04em}
  .aw-s-reviews .aw-fade{opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s ease}
  .aw-s-reviews .aw-fade.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.aw-s-reviews .aw-fade{opacity:1;transform:none;transition:none}}
  .aw-s-reviews .grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(14px,2vw,22px);max-width:1000px;margin:clamp(32px,4vw,48px) auto 0}
  .aw-s-reviews .bub{border-radius:24px 24px 24px 6px;padding:22px 24px}
  .aw-s-reviews .bub:nth-child(even){border-radius:24px 24px 6px 24px;margin-top:40px}
  .aw-s-reviews .bub p{font-size:15px;color:var(--ink)}
  .aw-s-reviews .who{display:flex;align-items:center;gap:10px;margin-top:14px;font-size:13px;font-weight:500}
  .aw-s-reviews .who img{width:32px;height:32px;border-radius:50%;object-fit:cover;background:var(--soft)}
  @media (max-width:800px){.aw-s-reviews .grid{grid-template-columns:1fr}.aw-s-reviews .bub:nth-child(even){margin-top:0}}
</style>

<div id="aw-s-reviews-{{ section.id }}" class="aw-s-reviews" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="aw-wrap">
    <div class="aw-center aw-fade">
      {%- if section.settings.label != blank -%}<span class="aw-label">{{ section.settings.label }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }} <span class="aw-grad">{{ section.settings.heading_highlight }}</span> {{ section.settings.heading_end }}</h2>
    </div>
    <div class="grid">
      {%- for block in section.blocks -%}
      <article class="bub aw-glass aw-fade" {{ block.shopify_attributes }}>
        <p>“{{ block.settings.quote }}”</p>
        <div class="who">
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}{%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" alt="" loading="lazy" onerror="this.remove()">{%- endif -%}
          {{ block.settings.name }}
        </div>
      </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('aw-s-reviews-{{ section.id }}');
    if (!root) return;
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .12 });
    root.querySelectorAll('.aw-fade').forEach(function (el) { if (window.Shopify && Shopify.designMode) el.classList.add('in'); else io.observe(el); });
  })();
</script>

{% schema %}
{
  "name": "Story: reviews",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "In their words"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading start",
      "default": "Loved by"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading (gradient part)",
      "default": "20,000+"
    },
    {
      "type": "text",
      "id": "heading_end",
      "label": "Heading end",
      "default": "women."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sandhya Gupta"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I found my perfect travel essentials. The fabric is so comfortable and breathable that I got it in all the colours available!"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Photo: image URL (used when no image is chosen)",
          "default": "https://anywearindia.com/cdn/shop/files/10802.jpg?v=1784094499&width=80"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Story: reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Sandhya Gupta",
            "quote": "I found my perfect travel essentials. The fabric is so comfortable and breathable that I got it in all the colours available!",
            "image_url": "https://anywearindia.com/cdn/shop/files/10802.jpg?v=1784094499&width=80"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Kavita Agarwal",
            "quote": "I wear my Anywear everywhere I go. It's so comfortable and versatile, perfect for stepping out or lounging in.",
            "image_url": "https://anywearindia.com/cdn/shop/files/10803.jpg?v=1784094500&width=80"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "Sakshi Chugh",
            "quote": "I wear my Anywear all day long. It's so breathable and perfectly fitted, with an incredibly impressive material.",
            "image_url": "https://anywearindia.com/cdn/shop/files/Sakshi_Chugh.png?v=1784099927&width=80"
          }
        },
        {
          "type": "review",
          "settings": {
