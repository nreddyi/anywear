{% comment %}
  Anywear – Our Story (Aurora). Section: Story: a day in Anywear
{% endcomment %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">
<style>
  .aw-s-day{--bg:#FBFAFD;--soft:#F1EEF7;--ink:#17142A;--body:#5E5A72;--mute:#9E99B2;--line:#E7E3F0;--accent:#6D4BD8;--r:26px;position:relative;font-family:'Poppins',system-ui,-apple-system,sans-serif;font-weight:300;font-size:15px;line-height:1.8;color:var(--ink);-webkit-font-smoothing:antialiased;padding:calc(var(--pt) * .6) 0 calc(var(--pb) * .6)}
  @media (min-width:750px){.aw-s-day{padding:var(--pt) 0 var(--pb)}}
  .aw-s-day *,.aw-s-day *::before,.aw-s-day *::after{box-sizing:border-box}
  .aw-s-day :is(h1,h2,h3,p,blockquote,figure){margin:0;font-family:inherit;color:inherit;font-weight:400;letter-spacing:-.025em;line-height:1.18}
  .aw-s-day p{line-height:1.8;letter-spacing:0;font-weight:300}
  .aw-s-day img{display:block;max-width:100%}
  .aw-s-day button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0;letter-spacing:inherit}
  .aw-s-day .aw-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,40px)}
  .aw-s-day .aw-label{display:block;font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;line-height:1.5}
  .aw-s-day .aw-ph{background:var(--soft);overflow:hidden;border-radius:var(--r)}
  .aw-s-day .aw-ph img{width:100%;height:100%;object-fit:cover}
  .aw-s-day .aw-muted{color:var(--body)}
  .aw-s-day .aw-glass{background:rgba(255,255,255,.55);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);border:1px solid rgba(255,255,255,.85);box-shadow:0 20px 50px rgba(40,20,90,.08)}
  .aw-s-day .aw-grad{background:linear-gradient(90deg,#6D4BD8,#D9546D 55%,#E8914A);-webkit-background-clip:text;background-clip:text;color:transparent}
  .aw-s-day .aw-center{text-align:center;max-width:720px;margin:0 auto}
  .aw-s-day .aw-center h2{font-size:clamp(28px,3.6vw,50px);font-weight:500;letter-spacing:-.04em}
  .aw-s-day .aw-fade{opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s ease}
  .aw-s-day .aw-fade.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.aw-s-day .aw-fade{opacity:1;transform:none;transition:none}}
  .aw-s-day .fan{position:relative;height:clamp(360px,40vw,500px);margin-top:clamp(28px,4vw,48px)}
  .aw-s-day .fc{position:absolute;left:50%;bottom:0;width:clamp(170px,18vw,250px);aspect-ratio:3/4;border-radius:20px;padding:8px;transform-origin:50% 120%;transform:translateX(-50%);transition:transform .6s cubic-bezier(.2,.8,.2,1)}
  .aw-s-day .fc .aw-ph{width:100%;height:100%;border-radius:14px}
  .aw-s-day .fc .tm{position:absolute;left:18px;top:18px;font-size:12px;font-weight:500;line-height:1.4;background:rgba(255,255,255,.9);padding:4px 10px;border-radius:999px}
  @media (max-width:700px){.aw-s-day .fc{width:140px}.aw-s-day .fan{overflow:hidden}}
  .aw-s-day .cap{text-align:center;margin-top:28px;min-height:70px}
  .aw-s-day .cap h3{font-size:22px;transition:opacity .3s}
  .aw-s-day .cap p{transition:opacity .3s}
</style>

<div id="aw-s-day-{{ section.id }}" class="aw-s-day" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="aw-wrap">
    <div class="aw-center aw-fade">
      {%- if section.settings.label != blank -%}<span class="aw-label">{{ section.settings.label }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="fan aw-fade">
      {%- for block in section.blocks -%}
      <button class="fc aw-glass" data-h="{{ block.settings.title | escape }}" data-d="{{ block.settings.text | escape }}" aria-label="{{ block.settings.time | escape }} {{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
        <div class="aw-ph">{%- if block.settings.image != blank -%}{%- assign aw_alt = block.settings.image.alt | default: "" -%}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 600, 1200', sizes: '250px', alt: aw_alt }}{%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" alt="" loading="lazy">{%- endif -%}</div>
        <span class="tm">{{ block.settings.time }}</span>
      </button>
      {%- endfor -%}
    </div>
    <div class="cap"><h3 class="fh"></h3><p class="aw-muted fd"></p></div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('aw-s-day-{{ section.id }}');
    if (!root) return;
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .12 });
    root.querySelectorAll('.aw-fade').forEach(function (el) { if (window.Shopify && Shopify.designMode) el.classList.add('in'); else io.observe(el); });
    var fcs = [].slice.call(root.querySelectorAll('.fc')), fh = root.querySelector('.fh'), fd = root.querySelector('.fd');
    if (!fcs.length) return;
    var fine = matchMedia('(hover:hover) and (min-width:901px)').matches, delay = {{ section.settings.autoplay_speed | times: 1000 }};
    var fi = Math.min(Math.floor((fcs.length - 1) / 2), fcs.length - 1), ft;
    function fan(i, user) {
      fi = i; var n = fcs.length, mid = (n - 1) / 2, wide = innerWidth > 700;
      fcs.forEach(function (c, k) { var off = k - mid, on = k === i, rot = wide ? off * 9 : off * 6, x = wide ? off * 120 : off * 42;
        c.style.zIndex = on ? 10 : 5 - Math.abs(k - i);
        c.style.transform = 'translateX(calc(-50% + ' + x + 'px)) rotate(' + (on ? 0 : rot) + 'deg) translateY(' + (on ? -26 : 0) + 'px) scale(' + (on ? 1.08 : .94) + ')'; });
      fh.style.opacity = 0; fd.style.opacity = 0;
      setTimeout(function () { fh.textContent = fcs[i].dataset.h; fd.textContent = fcs[i].dataset.d; fh.style.opacity = 1; fd.style.opacity = 1; }, 200);
      clearTimeout(ft); if (!user && delay > 0) ft = setTimeout(function () { fan((fi + 1) % fcs.length); }, delay);
    }
    fcs.forEach(function (c, i) { c.addEventListener('click', function () { fan(i, true); }); c.addEventListener('mouseenter', function () { if (fine) fan(i, true); }); });
    window.addEventListener('resize', function () { fan(fi, true); });
    root.addEventListener('shopify:block:select', function (e) { var i = fcs.indexOf(e.target); if (i > -1) fan(i, true); });
    fan(fi);
  })();
</script>

{% schema %}
{
  "name": "Story: a day in Anywear",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "A day in Anywear"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One wardrobe, every moment."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-advance every",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4,
      "info": "Set to 0 to turn off."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment card",
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Time tag",
          "default": "07:00"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Morning walks"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Starting the day at ease."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Photo: image URL (used when no image is chosen)",
          "default": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/SkyBlueLongSleevesTee1.jpg?width=600"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Story: a day in Anywear",
      "blocks": [
        {
          "type": "moment",
          "settings": {
            "time": "07:00",
            "title": "Morning walks",
            "text": "Starting the day at ease.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/SkyBlueLongSleevesTee1.jpg?width=600"
          }
        },
        {
          "type": "moment",
          "settings": {
            "time": "10:30",
            "title": "Long workdays",
            "text": "Comfortable, hour after hour.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/Anywear215394-Final.jpg?width=600"
          }
        },
        {
          "type": "moment",
          "settings": {
            "time": "16:00",
            "title": "Coffee runs",
            "text": "Ready to step out as you are.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/CedarWoodCroppedCrewNeckTee1.jpg?width=600"
          }
        },
        {
          "type": "moment",
          "settings": {
            "time": "Sat",
            "title": "Weekend errands",
            "text": "Moving between plans with ease.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/BlackBeautyEverywhereTee1.jpg?width=600"
          }
        },
        {
          "type": "moment",
          "settings": {
            "time": "20:30",
            "title": "Family dinners",
            "text": "Still comfortable at day's end.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/PeachyKeenEverywhereTee2.jpg?width=600"
          }
        }
      ]
    }
  ]
}
{% endschema %}
