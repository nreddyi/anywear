{% comment %}
  Anywear – Our Story (Aurora). Section: Story: values
{% endcomment %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">
<style>
  .aw-s-values{--bg:#FBFAFD;--soft:#F1EEF7;--ink:#17142A;--body:#5E5A72;--mute:#9E99B2;--line:#E7E3F0;--accent:#6D4BD8;--r:26px;position:relative;font-family:'Poppins',system-ui,-apple-system,sans-serif;font-weight:300;font-size:15px;line-height:1.8;color:var(--ink);-webkit-font-smoothing:antialiased;padding:calc(var(--pt) * .6) 0 calc(var(--pb) * .6)}
  @media (min-width:750px){.aw-s-values{padding:var(--pt) 0 var(--pb)}}
  .aw-s-values *,.aw-s-values *::before,.aw-s-values *::after{box-sizing:border-box}
  .aw-s-values :is(h1,h2,h3,p,blockquote,figure){margin:0;font-family:inherit;color:inherit;font-weight:400;letter-spacing:-.025em;line-height:1.18}
  .aw-s-values p{line-height:1.8;letter-spacing:0;font-weight:300}
  .aw-s-values img{display:block;max-width:100%}
  .aw-s-values button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0;letter-spacing:inherit}
  .aw-s-values .aw-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,40px)}
  .aw-s-values .aw-label{display:block;font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;line-height:1.5}
  .aw-s-values .aw-ph{background:var(--soft);overflow:hidden;border-radius:var(--r)}
  .aw-s-values .aw-ph img{width:100%;height:100%;object-fit:cover}
  .aw-s-values .aw-muted{color:var(--body)}
  .aw-s-values .aw-glass{background:rgba(255,255,255,.55);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);border:1px solid rgba(255,255,255,.85);box-shadow:0 20px 50px rgba(40,20,90,.08)}
  .aw-s-values .aw-grad{background:linear-gradient(90deg,#6D4BD8,#D9546D 55%,#E8914A);-webkit-background-clip:text;background-clip:text;color:transparent}
  .aw-s-values .aw-center{text-align:center;max-width:720px;margin:0 auto}
  .aw-s-values .aw-center h2{font-size:clamp(28px,3.6vw,50px);font-weight:500;letter-spacing:-.04em}
  .aw-s-values .aw-fade{opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s ease}
  .aw-s-values .aw-fade.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.aw-s-values .aw-fade{opacity:1;transform:none;transition:none}}
  .aw-s-values .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,2vw,24px);margin-top:clamp(32px,4vw,48px);perspective:1000px}
  .aw-s-values .tilt{border-radius:var(--r);padding:12px;transform-style:preserve-3d;transition:transform .2s ease-out}
  .aw-s-values .tilt .aw-ph{aspect-ratio:4/3;border-radius:18px}
  .aw-s-values .tilt .t{padding:18px 14px 12px;transform:translateZ(30px)}
  .aw-s-values .tilt h3{font-size:21px;display:flex;align-items:center;gap:10px;margin-bottom:6px}
  .aw-s-values .tilt h3 svg{width:22px;height:22px;stroke:var(--accent);fill:none;stroke-width:1.6;flex-shrink:0}
  @media (max-width:900px){.aw-s-values .grid{grid-template-columns:1fr}}
</style>

<div id="aw-s-values-{{ section.id }}" class="aw-s-values" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="aw-wrap">
    <div class="aw-center aw-fade">
      {%- if section.settings.label != blank -%}<span class="aw-label">{{ section.settings.label }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="grid">
      {%- for block in section.blocks -%}
      <article class="tilt aw-glass aw-fade" {{ block.shopify_attributes }}>
        <div class="aw-ph">{%- if block.settings.image != blank -%}{%- assign aw_alt = block.settings.image.alt | default: "Anywear" -%}{{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 800, 1600', sizes: '(min-width: 900px) 380px, 100vw', alt: aw_alt }}{%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" alt="Anywear" loading="lazy">{%- endif -%}</div>
        <div class="t"><h3>{%- case block.settings.icon -%}{%- when 'comfort' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8c3-3 5 3 8 0s5 3 8 0"/><path d="M4 13c3-3 5 3 8 0s5 3 8 0"/><path d="M4 18c3-3 5 3 8 0s5 3 8 0"/></svg>{%- when 'fit' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="3"/><path d="M6 21v-5a6 6 0 0 1 12 0v5"/></svg>{%- when 'colour' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="8.5" cy="10" r="1.3"/><circle cx="12" cy="7.5" r="1.3"/><circle cx="15.5" cy="10" r="1.3"/></svg>{%- endcase -%}{{ block.settings.title }}</h3><p class="aw-muted">{{ block.settings.text }}</p></div>
      </article>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('aw-s-values-{{ section.id }}');
    if (!root) return;
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .12 });
    root.querySelectorAll('.aw-fade').forEach(function (el) { if (window.Shopify && Shopify.designMode) el.classList.add('in'); else io.observe(el); });
    if (matchMedia('(hover:hover) and (min-width:901px)').matches) root.querySelectorAll('.tilt').forEach(function (c) {
      c.addEventListener('mousemove', function (e) { var r = c.getBoundingClientRect(), x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5; c.style.transform = 'rotateY(' + x * 10 + 'deg) rotateX(' + (-y * 10) + 'deg)'; });
      c.addEventListener('mouseleave', function () { c.style.transform = ''; });
    });
  })();
</script>

{% schema %}
{
  "name": "Story: values",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "What we believe"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every detail, considered with purpose."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "comfort",
          "options": [
            {
              "value": "comfort",
              "label": "Comfort (waves)"
            },
            {
              "value": "fit",
              "label": "Fit (person)"
            },
            {
              "value": "colour",
              "label": "Colour (palette)"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Comfort"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every fabric is carefully chosen, so you feel at ease wherever the day takes you."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Photo: image URL (used when no image is chosen)",
          "default": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/StarWhiteEverywhereTee3.jpg?width=800"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Story: values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "comfort",
            "title": "Comfort",
            "text": "Every fabric is carefully chosen, so you feel at ease wherever the day takes you.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/StarWhiteEverywhereTee3.jpg?width=800"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "fit",
            "title": "Fit",
            "text": "Every silhouette is designed with Indian body types in mind.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/Anywear215255-Final.jpg?width=800"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "colour",
            "title": "Colour",
            "text": "Every colour is selected to complement Indian skin tones.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/CedarWoodEverywhereTee1.jpg?width=800"
          }
        }
      ]
    }
  ]
}
{% endschema %}
