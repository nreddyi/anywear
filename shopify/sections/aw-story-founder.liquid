{% comment %}
  Anywear – Our Story (Aurora). Section: Story: founder note
{% endcomment %}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300&display=swap" rel="stylesheet">
<style>
  .aw-s-founder{--bg:#FBFAFD;--soft:#F1EEF7;--ink:#17142A;--body:#5E5A72;--mute:#9E99B2;--line:#E7E3F0;--accent:#6D4BD8;--r:26px;position:relative;font-family:'Poppins',system-ui,-apple-system,sans-serif;font-weight:300;font-size:15px;line-height:1.8;color:var(--ink);-webkit-font-smoothing:antialiased;padding:calc(var(--pt) * .6) 0 calc(var(--pb) * .6)}
  @media (min-width:750px){.aw-s-founder{padding:var(--pt) 0 var(--pb)}}
  .aw-s-founder *,.aw-s-founder *::before,.aw-s-founder *::after{box-sizing:border-box}
  .aw-s-founder :is(h1,h2,h3,p,blockquote,figure){margin:0;font-family:inherit;color:inherit;font-weight:400;letter-spacing:-.025em;line-height:1.18}
  .aw-s-founder p{line-height:1.8;letter-spacing:0;font-weight:300}
  .aw-s-founder img{display:block;max-width:100%}
  .aw-s-founder button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0;letter-spacing:inherit}
  .aw-s-founder .aw-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,40px)}
  .aw-s-founder .aw-label{display:block;font-size:12px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;line-height:1.5}
  .aw-s-founder .aw-ph{background:var(--soft);overflow:hidden;border-radius:var(--r)}
  .aw-s-founder .aw-ph img{width:100%;height:100%;object-fit:cover}
  .aw-s-founder .aw-muted{color:var(--body)}
  .aw-s-founder .aw-glass{background:rgba(255,255,255,.55);backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3);border:1px solid rgba(255,255,255,.85);box-shadow:0 20px 50px rgba(40,20,90,.08)}
  .aw-s-founder .aw-grad{background:linear-gradient(90deg,#6D4BD8,#D9546D 55%,#E8914A);-webkit-background-clip:text;background-clip:text;color:transparent}
  .aw-s-founder .aw-center{text-align:center;max-width:720px;margin:0 auto}
  .aw-s-founder .aw-center h2{font-size:clamp(28px,3.6vw,50px);font-weight:500;letter-spacing:-.04em}
  .aw-s-founder .aw-fade{opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s ease}
  .aw-s-founder .aw-fade.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.aw-s-founder .aw-fade{opacity:1;transform:none;transition:none}}
  .aw-s-founder .card{border-radius:34px;padding:clamp(32px,6vw,80px);display:grid;grid-template-columns:auto 1fr;gap:clamp(28px,5vw,72px);align-items:center}
  .aw-s-founder .ring{position:relative;width:clamp(170px,19vw,250px);aspect-ratio:1;border-radius:50%;padding:7px;background:conic-gradient(from 0deg,#6D4BD8,#D9546D,#E8914A,#2FBF71,#6D4BD8);animation:awspin 10s linear infinite}
  .aw-s-founder .ring .aw-ph{width:100%;height:100%;border-radius:50%;border:5px solid #fff;animation:awspin 10s linear infinite reverse}
  .aw-s-founder .ring img{object-position:var(--fx,24%) var(--fy,50%);transform:scale(var(--fz,1.55));transform-origin:var(--fx,24%) var(--fy,52%)}
  @keyframes awspin{to{transform:rotate(360deg)}}
  .aw-s-founder blockquote{font-size:clamp(21px,2.5vw,34px);line-height:1.38;letter-spacing:-.02em}
  .aw-s-founder .more{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s ease}
  .aw-s-founder .more > div{overflow:hidden}
  .aw-s-founder .more.open{grid-template-rows:1fr}
  .aw-s-founder .more p{margin-top:14px;color:var(--body)}
  .aw-s-founder .sig{margin-top:18px;font-size:14px}
  .aw-s-founder .sig b{font-weight:500}
  .aw-s-founder .tlink{margin-top:12px;font-size:13.5px;font-weight:500;color:var(--accent);border-bottom:1px solid currentColor;padding-bottom:1px}
  @media (max-width:800px){.aw-s-founder .card{grid-template-columns:1fr}}
  @media (prefers-reduced-motion:reduce){.aw-s-founder .ring,.aw-s-founder .ring .aw-ph{animation:none}}
</style>

<div id="aw-s-founder-{{ section.id }}" class="aw-s-founder" style="--pt:{{ section.settings.padding_top }}px;--pb:{{ section.settings.padding_bottom }}px">
  <div class="aw-wrap">
    <div class="card aw-glass aw-fade">
      <div class="ring" style="--fx:{{ section.settings.focus_x }}%;--fy:{{ section.settings.focus_y }}%;--fz:{{ section.settings.zoom | divided_by: 100.0 }}"><div class="aw-ph">{%- if section.settings.image != blank -%}{%- assign aw_alt = section.settings.image.alt | default: "Anywear's founder" -%}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 600, 1200', sizes: '250px', alt: aw_alt }}{%- elsif section.settings.image_url != blank -%}<img src="{{ section.settings.image_url }}" alt="Anywear's founder" loading="lazy">{%- endif -%}</div></div>
      <div>
        {%- if section.settings.label != blank -%}<span class="aw-label">{{ section.settings.label }}</span>{%- endif -%}
        <blockquote>“{{ section.settings.quote }}”</blockquote>
        {%- if section.settings.letter != blank -%}
        <div class="more" id="awm-{{ section.id }}"><div>{{ section.settings.letter }}</div></div>
        {%- endif -%}
        <p class="sig"><b>{{ section.settings.name }}</b> <span class="aw-muted">· {{ section.settings.role }}</span></p>
        {%- if section.settings.letter != blank -%}
        <button class="tlink" data-more="awm-{{ section.id }}" aria-controls="awm-{{ section.id }}" aria-expanded="false" data-less="{{ section.settings.less_label | escape }}">{{ section.settings.more_label }}</button>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('aw-s-founder-{{ section.id }}');
    if (!root) return;
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { threshold: .12 });
    root.querySelectorAll('.aw-fade').forEach(function (el) { if (window.Shopify && Shopify.designMode) el.classList.add('in'); else io.observe(el); });
    root.querySelectorAll('[data-more]').forEach(function (b) { var m = document.getElementById(b.dataset.more), t = b.textContent;
      b.addEventListener('click', function () { var o = m.classList.toggle('open'); b.setAttribute('aria-expanded', o); b.textContent = o ? b.dataset.less : t; }); });
  })();
</script>

{% schema %}
{
  "name": "Story: founder note",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "From our founder"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "When I started Anywear, I wasn't trying to create another clothing brand. I wanted to create clothing that women genuinely love living in."
    },
    {
      "type": "richtext",
      "id": "letter",
      "label": "Full letter (shown on 'Read the full letter')",
      "default": "<p>As women, our days are never just one thing. We move between work, family, travel, meetings, celebrations, errands, and moments of rest, often all in the same day. Yet finding clothes that are comfortable enough for real life and beautiful enough to wear confidently everywhere isn't always easy. That's where Anywear began.</p><p>Every fabric is carefully chosen, every silhouette is designed with Indian body types in mind, and every colour is selected to complement Indian skin tones. Because we believe comfort should never come at the cost of style, and style should never come at the cost of comfort.</p><p>Thank you for letting us be a part of your every day.</p>"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "[Founder Name]"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder, Anywear"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Button text",
      "default": "Read the full letter"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Button text when open",
      "default": "Show less"
    },
    {
      "type": "header",
      "content": "Portrait"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Portrait: image URL (used when no image is chosen)",
      "default": "https://anywearindia.com/cdn/shop/files/founders-note.webp?v=1781594360&width=800"
    },
    {
      "type": "range",
      "id": "zoom",
      "label": "Portrait zoom",
      "min": 100,
      "max": 250,
      "step": 5,
      "unit": "%",
      "default": 155,
      "info": "The default zooms into the founder in the current photo. Use 100% for a ready-cropped portrait."
    },
    {
      "type": "range",
      "id": "focus_x",
      "label": "Portrait focus (left–right)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 24
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Portrait focus (top–bottom)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Story: founder note"
    }
  ]
}
{% endschema %}
