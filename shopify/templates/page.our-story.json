      "blocks": {
        "story_moments_0": {
          "type": "panel",
          "settings": {
            "number": "01",
            "title": "The overlooked",
            "text": "We spend most of our lives in everyday clothes: busy mornings, long workdays, coffee runs and family dinners. Yet they're the pieces we think about least.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/StarWhiteEverywhereTee2.jpg?width=900"
          }
        },
        "story_moments_1": {
          "type": "panel",
          "settings": {
            "number": "02",
            "title": "The search",
            "text": "Our days are never just one thing. Finding clothes comfortable enough for real life and beautiful enough to wear everywhere isn't always easy.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/CeladonEverywhereTee1.jpg?width=900"
          }
        },
        "story_moments_2": {
          "type": "panel",
          "settings": {
            "number": "03",
            "title": "The answer",
            "text": "Anywear was created to change that: thoughtfully designed essentials that make women feel comfortable, confident and at ease.",
            "image_url": "https://cdn.shopify.com/s/files/1/0699/3988/8363/files/PeachyKeenEverywhereTee2.jpg?width=900"
          }
        }
      },
      "block_order": [
        "story_moments_0",
        "story_moments_1",
        "story_moments_2"
      ]
    },
